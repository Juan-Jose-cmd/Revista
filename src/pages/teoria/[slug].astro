---
// src/pages/teoria/[slug].astro
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const cuadernos = await getCollection('teoria');
  return cuadernos.map((cuaderno) => ({
    params: { slug: cuaderno.id },
    props: { cuaderno },
  }));
}

interface Props {
  cuaderno: CollectionEntry<'teoria'>;
}

const { cuaderno } = Astro.props;

// ✅ Astro 5: render se importa y se llama como función
const { Content } = await render(cuaderno);
---

<Base title={`${cuaderno.data.titulo} — Teoría`} description={cuaderno.data.resumen}>
  <section class="page-hero">
    <div class="contenedor">
      <nav class="migas" aria-label="Ubicación">
        <a href="/">Inicio</a>
        <span class="separador">/</span>
        <a href="/teoria">Teoría</a>
        <span class="separador">/</span>
        <span>Cuaderno {cuaderno.data.numero}</span>
      </nav>
      <h1>{cuaderno.data.titulo}</h1>
      <p class="bajada">{cuaderno.data.resumen}</p>
    </div>
  </section>

  <div class="contenido">
    <article class="articulo">
      <p class="meta">
        <span>Cuaderno {cuaderno.data.numero}</span>
        <span>Nivel {cuaderno.data.nivel}</span>
      </p>

      <div class="articulo-cuerpo">
        <Content />
      </div>

      <p style="margin-top:2rem;">
        <a href="/teoria" class="enlace-flecha">Volver a Teoría</a>
      </p>
    </article>
  </div>
</Base>