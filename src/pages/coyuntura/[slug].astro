---
// src/pages/coyuntura/[slug].astro
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const articulos = await getCollection('coyuntura');
  return articulos.map((articulo) => ({
    params: { slug: articulo.id },
    props: { articulo },
  }));
}

interface Props {
  articulo: CollectionEntry<'coyuntura'>;
}

const { articulo } = Astro.props;

const { Content } = await render(articulo);

const fecha = articulo.data.fecha.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title={`${articulo.data.titulo} — Coyuntura`}
  description={articulo.data.resumen}
>
  <section class="page-hero">
    <div class="contenedor">
      <nav class="migas" aria-label="Ubicación">
        <a href="/">Inicio</a>
        <span class="separador" aria-hidden="true">/</span>
        <a href="/coyuntura">Coyuntura</a>
        <span class="separador" aria-hidden="true">/</span>
        <span>{articulo.data.titulo}</span>
      </nav>
      <h1>{articulo.data.titulo}</h1>
      <p class="bajada">{articulo.data.resumen}</p>
    </div>
  </section>

  <div class="contenido">
    <article class="articulo">
      <p class="meta">
        <span>{fecha}</span>
        <span>{articulo.data.categoria}</span>
      </p>

      <div class="articulo-cuerpo">
        <Content />
      </div>

      <p style="margin-top:2rem;">
        <a href="/coyuntura" class="enlace-flecha">Volver a Coyuntura</a>
      </p>
    </article>
  </div>
</Base>